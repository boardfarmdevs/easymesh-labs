#!/usr/bin/env python3
"""Clone or update the four projects into this workspace (manifest.json).

    ./sync              each project on its branch, fast-forwarded from origin
    ./sync --pinned     each project at the commit manifest.json pins (detached HEAD)
    ./sync NAME...      only those projects

A project with local changes, commits of its own, or on another branch is left
as it is and reported: sync never discards work.
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def git(path, *args, check=True):
    result = subprocess.run(["git", "-C", str(path), *args], capture_output=True, text=True)
    if check and result.returncode:
        raise SystemExit(f"{path.name}: git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout.strip()


def sync(project, pinned):
    path = ROOT / project["name"]
    if not path.exists():
        subprocess.run(
            ["git", "clone", "-q", "--branch", project["branch"], project["url"], str(path)],
            check=True,
        )
    else:
        git(path, "fetch", "-q", "--prune", "origin")
    if git(path, "status", "--porcelain"):
        return "left as is: local changes"
    if pinned:
        git(path, "checkout", "-q", "--detach", project["commit"])
        return f"at the pinned {project['commit'][:10]}"
    branch = git(path, "branch", "--show-current", check=False)
    if branch == "":  # detached, e.g. after --pinned
        git(path, "checkout", "-q", project["branch"])
    elif branch != project["branch"]:
        return f"left as is: on branch {branch}"
    upstream = f"origin/{project['branch']}"
    ahead = int(git(path, "rev-list", "--count", f"{upstream}..HEAD"))
    if ahead:
        return f"left as is: {ahead} commit(s) not on {upstream}"
    git(path, "merge", "-q", "--ff-only", upstream)
    return f"{project['branch']} at {git(path, 'rev-parse', '--short=10', 'HEAD')}"


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("names", nargs="*", help="projects (default: all)")
    parser.add_argument("--pinned", action="store_true", help="check out the pinned commits")
    args = parser.parse_args()
    projects = json.loads((ROOT / "manifest.json").read_text())["projects"]
    unknown = set(args.names) - {p["name"] for p in projects}
    if unknown:
        raise SystemExit(f"not in manifest.json: {', '.join(sorted(unknown))}")
    for project in projects:
        if not args.names or project["name"] in args.names:
            print(f"{project['name']:24} {sync(project, args.pinned)}", flush=True)


if __name__ == "__main__":
    sys.exit(main())
