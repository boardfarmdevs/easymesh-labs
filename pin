#!/usr/bin/env python3
"""Pin each project at the commit it has in this workspace (manifest.json).

    ./pin              every project
    ./pin NAME...      only those projects

A project is pinned only when its checkout is clean and its commit is on
origin, so a pin always names a commit anyone can fetch.
"""

import argparse
import json
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent
MANIFEST = ROOT / "manifest.json"


def git(path, *args):
    return subprocess.run(
        ["git", "-C", str(path), *args], capture_output=True, text=True, check=True
    ).stdout.strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("names", nargs="*", help="projects (default: all)")
    args = parser.parse_args()
    manifest = json.loads(MANIFEST.read_text())
    for project in manifest["projects"]:
        if args.names and project["name"] not in args.names:
            continue
        path = ROOT / project["name"]
        if not path.is_dir():
            raise SystemExit(f"{project['name']}: not in the workspace (./sync first)")
        if git(path, "status", "--porcelain"):
            raise SystemExit(f"{project['name']}: local changes; commit and push first")
        commit = git(path, "rev-parse", "HEAD")
        git(path, "fetch", "-q", "origin")
        if not git(path, "branch", "-r", "--contains", commit):
            raise SystemExit(f"{project['name']}: {commit[:10]} is not on origin; push first")
        old, project["commit"] = project["commit"], commit
        print(f"{project['name']:24} {old[:10]} -> {commit[:10]}")
    MANIFEST.write_text(json.dumps(manifest, indent=2) + "\n")


if __name__ == "__main__":
    main()
